# Configurações do PlanningYrd
PORT=3000
DATABASE_URL=data/planning.db
DATABASE_PATH=planningyrd.db
RETENTION_DAYS=60
ROOM_RETENTION_DAYS=60

# Telemetria anônima com Umami (Opcional - deixe vazio para desativar)
# UMAMI_SCRIPT_URL=https://analytics.yared.com.br/script.js
# UMAMI_WEBSITE_ID=seu-website-id-aqui
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=

# Token de acesso ao painel de administração (se vazio, um token temporário aleatório é gerado no log)
ADMIN_TOKEN=

# URLs dos outros serviços do Ecossistema (Opcional - deixe vazio para ocultar do switcher)
VITE_RETRO_URL=https://retro.yared.com.br
VITE_DAILY_URL=https://daily.yared.com.br
VITE_PLANNING_URL=https://planning.yared.com.br
VITE_COFFEE_URL=https://coffee.yared.com.br
